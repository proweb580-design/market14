<%- include('../partials/head') %>
<%- include('../partials/header') %>

<main class="main-content" style="display: flex; align-items: center; justify-content: center; min-height: 55vh;">
  <div class="container" style="text-align: center; max-width: 600px; padding: 3rem 1.5rem;">
    <div style="font-size: 5rem; font-weight: 800; line-height: 1; margin-bottom: 1rem; color: var(--danger);">
      500
    </div>
    <h1 style="font-size: 1.75rem; margin-bottom: 1rem;">Внутренняя ошибка сервера</h1>
    <p style="margin-bottom: 2rem; color: var(--text-secondary); font-size: 1rem;">
      <%= typeof error !== 'undefined' ? error : 'Произошла непредвиденная ошибка при обработке запроса.' %>
    </p>
    <a href="/" class="btn btn-primary">Вернуться на главную</a>
  </div>
</main>

<%- include('../partials/footer') %>
