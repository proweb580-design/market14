<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title : siteName %></title>
  <meta name="description" content="Премиальный интернет-магазин техники и электроники в Ташкенте. Смартфоны, ноутбуки, гаджеты с официальной гарантией и доставкой. Цены в сумах (UZS).">

  <!-- Google Fonts: Outfit & Inter -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Outfit:wght@500;600;700;800&display=swap" rel="stylesheet">

  <!-- CSS Design System -->
  <link rel="stylesheet" href="/css/tokens.css">
  <link rel="stylesheet" href="/css/base.css">
  <link rel="stylesheet" href="/css/components.css">
  <% if (typeof extraCss !== 'undefined') { %>
    <% extraCss.forEach(function(cssFile) { %>
      <link rel="stylesheet" href="/css/<%= cssFile %>">
    <% }); %>
  <% } %>
</head>
