<!-- Top Info Bar -->
<div class="top-bar">
  <div class="container top-bar-inner">
    <div class="top-bar-left">
      <div class="top-bar-item city-badge">
        <span>📍</span> <span>Ташкент (доставка за 2–4 часа)</span>
      </div>
      <div class="top-bar-item">
        <span>🕒 Пн-Вс: 09:00 — 22:00</span>
      </div>
    </div>
    <div class="top-bar-right">
      <div class="top-bar-item">
        <span>📞 <a href="tel:+998712000000">+998 (71) 200-00-00</a></span>
      </div>
      <div class="top-bar-item">
        <a href="/account">Личный кабинет</a>
      </div>
    </div>
  </div>
</div>

<!-- Main Sticky Header -->
<header class="header-main">
  <div class="container header-container">
    <!-- Brand Logo -->
    <a href="/" class="brand-logo" id="header-logo">
      <div class="brand-icon">⚡</div>
      <span>Tash<span class="brand-highlight">Tech</span></span>
    </a>

    <!-- Catalog Button -->
    <a href="/catalog" class="btn-catalog" id="header-catalog-btn">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
        <rect x="3" y="3" width="7" height="7"></rect>
        <rect x="14" y="3" width="7" height="7"></rect>
        <rect x="14" y="14" width="7" height="7"></rect>
        <rect x="3" y="14" width="7" height="7"></rect>
      </svg>
      <span>Каталог</span>
    </a>

    <!-- Search Form -->
    <form action="/catalog" method="GET" class="search-form" id="header-search-form">
      <div class="search-input-wrapper">
        <span class="search-icon">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
        </span>
        <input 
          type="text" 
          name="q" 
          class="search-input" 
          placeholder="Поиск смартфонов, ноутбуков, техники..." 
          id="header-search-input"
          autocomplete="off"
        >
        <button type="submit" class="search-submit-btn" id="header-search-submit">Найти</button>
      </div>
    </form>

    <!-- Header Actions -->
    <div class="header-actions">
      <!-- Compare -->
      <a href="/compare" class="action-btn <%= typeof activeNav !== 'undefined' && activeNav === 'compare' ? 'active' : '' %>" id="nav-compare" title="Сравнение">
        <div class="action-icon-wrap">
          <span class="action-icon">⚖️</span>
          <span class="badge-count cyan" id="badge-compare" style="display: none;">0</span>
        </div>
        <span class="action-label">Сравнение</span>
      </a>

      <!-- Favorites -->
      <a href="/favorites" class="action-btn <%= typeof activeNav !== 'undefined' && activeNav === 'favorites' ? 'active' : '' %>" id="nav-favorites" title="Избранное">
        <div class="action-icon-wrap">
          <span class="action-icon">❤️</span>
          <span class="badge-count" id="badge-fav" style="display: none;">0</span>
        </div>
        <span class="action-label">Избранное</span>
      </a>

      <!-- Cart -->
      <a href="/cart" class="action-btn <%= typeof activeNav !== 'undefined' && activeNav === 'cart' ? 'active' : '' %>" id="nav-cart" title="Корзина">
        <div class="action-icon-wrap">
          <span class="action-icon">🛒</span>
          <span class="badge-count" id="badge-cart" style="display: none;">0</span>
        </div>
        <span class="action-label">Корзина</span>
      </a>

      <!-- Account -->
      <a href="/account" class="action-btn <%= typeof activeNav !== 'undefined' && activeNav === 'account' ? 'active' : '' %>" id="nav-account" title="Профиль">
        <div class="action-icon-wrap">
          <span class="action-icon">👤</span>
        </div>
        <span class="action-label">Войти</span>
      </a>

      <!-- Mobile Burger Toggle -->
      <button class="mobile-menu-btn" id="mobile-menu-toggle" aria-label="Открыть меню">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="3" y1="12" x2="21" y2="12"></line>
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <line x1="3" y1="18" x2="21" y2="18"></line>
        </svg>
      </button>
    </div>
  </div>
</header>

<!-- Quick Categories Bar -->
<nav class="nav-categories" aria-label="Быстрые категории">
  <div class="container">
    <ul class="nav-categories-list">
      <li>
        <a href="/catalog?cat=smartphones" class="nav-category-link">📱 Смартфоны</a>
      </li>
      <li>
        <a href="/catalog?cat=laptops" class="nav-category-link">💻 Ноутбуки</a>
      </li>
      <li>
        <a href="/catalog?cat=audio" class="nav-category-link">🎧 Наушники и аудио</a>
      </li>
      <li>
        <a href="/catalog?cat=smart-home" class="nav-category-link">📺 Телевизоры и Smart Home</a>
      </li>
      <li>
        <a href="/catalog?cat=wearables" class="nav-category-link">⌚ Смарт-часы</a>
      </li>
      <li>
        <a href="/catalog?cat=accessories" class="nav-category-link">⚡ Аксессуары</a>
      </li>
      <li>
        <a href="/catalog?sort=new" class="nav-category-link" style="color: var(--accent-cyan);">🔥 Новинки 2025</a>
      </li>
    </ul>
  </div>
</nav>
