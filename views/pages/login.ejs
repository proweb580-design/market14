<%- include('../partials/head', { extraCss: ['auth.css'] }) %>
<%- include('../partials/header') %>

<main class="main-content">
  <div class="auth-wrapper">
    <div class="auth-card">
      <div class="auth-header">
        <h1>Вход в аккаунт</h1>
        <p>Управляйте своими заказами, корзиной и скидками</p>
      </div>

      <!-- Quick 1-click Demo Login -->
      <a href="/account" class="btn-demo-quick-login" id="btn-quick-demo-login">
        <span>⚡ Войти в демо-аккаунт в 1 клик</span>
      </a>

      <!-- Google OAuth Button -->
      <a href="/account" class="btn-social-oauth" style="margin-top: 0.75rem;">
        <svg width="18" height="18" viewBox="0 0 24 24">
          <path fill="#4285F4" d="M23.745 12.27c0-.7-.06-1.4-.19-2.07H12v4.51h6.6c-.29 1.52-1.14 2.82-2.4 3.68v3.05h3.88c2.27-2.09 3.665-5.17 3.665-9.17z"/>
          <path fill="#34A853" d="M12 24c3.24 0 5.95-1.08 7.93-2.91l-3.88-3.05c-1.08.72-2.45 1.16-4.05 1.16-3.12 0-5.77-2.1-6.72-4.93H1.25v3.15C3.26 21.36 7.33 24 12 24z"/>
          <path fill="#FBBC05" d="M5.28 14.27c-.25-.72-.38-1.49-.38-2.27s.13-1.55.38-2.27V6.58H1.25C.45 8.18 0 10.03 0 12s.45 3.82 1.25 5.42l4.03-3.15z"/>
          <path fill="#EA4335" d="M12 4.75c1.77 0 3.35.61 4.6 1.8l3.42-3.42C17.95 1.19 15.24 0 12 0 7.33 0 3.26 2.64 1.25 6.58l4.03 3.15c.95-2.83 3.6-4.98 6.72-4.98z"/>
        </svg>
        <span>Продолжить через Google</span>
      </a>

      <div class="auth-divider">
        <span>или по email</span>
      </div>

      <form action="/login" method="POST">
        <div class="form-group">
          <label class="form-label" for="login-email">Email адрес</label>
          <input type="email" id="login-email" name="email" class="form-input" placeholder="name@example.uz" required value="aziz.karimov@example.uz">
        </div>

        <div class="form-group">
          <label class="form-label" for="login-pass">Пароль</label>
          <input type="password" id="login-pass" name="password" class="form-input" placeholder="••••••••" required value="password123">
        </div>

        <button type="submit" class="btn-auth-submit" id="btn-submit-login">
          Войти
        </button>
      </form>

      <div class="auth-footer-link">
        Ещё нет аккаунта? <a href="/register">Зарегистрироваться</a>
      </div>
    </div>
  </div>
</main>

<%- include('../partials/footer') %>
