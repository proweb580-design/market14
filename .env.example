NODE_ENV=development
PORT=3000
SITE_NAME=TashTech — Магазин техники
DATABASE_URL=postgresql://user:password@ep-sample.eu-central-1.aws.neon.tech/neondb?sslmode=require
SESSION_SECRET=super_secret_session_key_change_in_production

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# Stripe (test mode only: keys start with sk_test_ / whsec_)
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
# Charge currency and UZS rate per 1 unit of it (uzs is also supported: then rate is ignored)
STRIPE_CURRENCY=usd
STRIPE_UZS_RATE=12700
# Public site URL for Stripe return links (defaults to the request host)
APP_BASE_URL=http://localhost:3000
