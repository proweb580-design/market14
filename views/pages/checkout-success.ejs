<%- include('../partials/head', { extraCss: ['checkout.css'] }) %>
<%- include('../partials/header') %>

<main class="main-content">
  <div class="container">
    <div class="order-success-box">
      <div class="order-success-icon">✓</div>
      
      <h1 style="font-size: clamp(1.75rem, 3.5vw, 2.5rem); font-weight: 800; margin-bottom: 0.75rem;">
        Спасибо за заказ!
      </h1>
      
      <p style="font-size: 1.0625rem; color: var(--text-secondary); margin-bottom: 1.5rem; line-height: 1.6;">
        Ваш заказ успешно принят и передан в службу доставки TashTech.
      </p>

      <div class="order-badge-number">
        Номер заказа: <span style="color: #fff;"><%= orderNumber %></span>
      </div>

      <div style="background: var(--surface-raised); border: 1px solid var(--border); border-radius: var(--radius-sm); padding: 1.25rem; text-align: left; margin-bottom: 2rem; font-size: 0.875rem; line-height: 1.8;">
        <div><strong>⏱️ Сроки доставки:</strong> курьер свяжется с вами в течение 10–15 минут для подтверждения адреса. Доставка по Ташкенту сегодня с 10:00 до 21:00.</div>
        <div><strong>📞 Служба поддержки:</strong> +998 (71) 200-00-00 (ежедневно)</div>
        <div><strong>📍 Статус:</strong> вы можете отслеживать историю и состояние заказа в личном кабинете.</div>
      </div>

      <div style="display: flex; justify-content: center; gap: 1rem; flex-wrap: wrap;">
        <a href="/account" class="btn btn-primary" id="btn-success-to-orders">
          <span>📦 Мои заказы</span>
        </a>
        <a href="/catalog" class="btn btn-secondary" id="btn-success-to-catalog">
          <span>Продолжить покупки</span>
        </a>
      </div>
    </div>
  </div>
</main>

<%- include('../partials/footer') %>
